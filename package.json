{
  "name": "spawn-mcp",
  "version": "1.3.0",
  "description": "Local MCP server for the Spawn Games agent API + Playwright play client",
  "type": "module",
  "bin": {
    "spawn-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src",
    "mcp.example.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "setup": "playwright install chromium",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/compile.test.ts test/config.test.ts test/exec.test.ts test/skills.test.ts test/spec-merge.test.ts test/sync.test.ts test/team.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "check": "npm run typecheck && npm run test",
    "prepare": "tsc"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "spawn",
    "spawn-games"
  ],
  "author": "wfbcargo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wfbcargo/wfbcargo_spawn_mcp.git"
  },
  "homepage": "https://github.com/wfbcargo/wfbcargo_spawn_mcp#readme",
  "bugs": {
    "url": "https://github.com/wfbcargo/wfbcargo_spawn_mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "playwright": "^1.54.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
